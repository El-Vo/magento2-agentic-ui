# LLM
# Nicht auskommentiert setzen, sonst ueberschreibt der (leere) Wert die Umgebungsvariable
# (z.B. Codespaces-Secret MISTRAL_API_KEY) beim Sourcing in scripts/common.sh:
# MISTRAL_API_KEY=
AGENT_MODEL=mistral-large-latest

# Magento lokal (php -S auf Port 8080, siehe scripts/magento.sh)
MAGENTO_BASE_URL=http://localhost:8080
MAGENTO_PUBLIC_URL=http://localhost:8080

# Lokale Dienste (Defaults siehe scripts/common.sh)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
ES_HOST=127.0.0.1
ES_PORT=9200

AGENT_PORT=8000
WIDGET_PORT=5173
AGENT_ALLOWED_ORIGIN=http://localhost:5173

# Demo-Daten beim Magento-Install seeden (eigener Seeder, kein Marketplace-Login noetig)
INSTALL_SAMPLE_DATA=1
