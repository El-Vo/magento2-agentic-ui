{
  "name": "Magento 2 Agentic UI (lokal, kein Docker)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [3306, 5173, 8000, 8080, 9200],
  "portsAttributes": {
    "3306": { "label": "MariaDB (lokal, .local/mysql)" },
    "5173": { "label": "Chat-Widget (Vite)", "onAutoForward": "openPreview" },
    "8000": { "label": "Agent API (uvicorn)", "onAutoForward": "silent" },
    "8080": { "label": "Magento Demo-Shop (php -S)", "onAutoForward": "openPreview" },
    "9200": { "label": "Elasticsearch (lokal)" }
  },
  "updateContentCommand": "bash scripts/codespace-up.sh",
  "postCreateCommand": "bash scripts/codespace-up.sh",
  "postStartCommand": "bash scripts/codespace-up.sh",
  "postAttachCommand": "make ps",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mistralai.mistral-vibe-code"
      ]
    }
  }
}
